// osv-intake - Application Launcher UI
// Shows search input with results list

import { LineEdit } from "std-widgets.slint";

// ============================================================================
// OSV COLOR PALETTE
// ============================================================================

global OsvPalette {
    out property <color> black: #121216;
    out property <color> dark: #1c1c22;
    out property <color> surface: #26262e;
    out property <color> border: #3a3a44;
    out property <color> muted: #80808c;
    out property <color> text: #dcdce4;
    out property <color> bright: #f8f8fc;
    out property <color> accent: #58a6ff;
}

// ============================================================================
// APP RESULT ITEM
// ============================================================================

struct AppResult {
    name: string,
    description: string,
    exec: string,
}

component AppResultItem inherits Rectangle {
    in property <string> app-name;
    in property <string> app-description;
    in property <bool> is-selected;

    callback clicked();

    height: 32px;
    background: is-selected ? OsvPalette.accent.with-alpha(0.15) : transparent;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        // App name
        Text {
            text: app-name;
            color: is-selected ? OsvPalette.bright : OsvPalette.text;
            font-size: 12px;
            font-weight: is-selected ? 500 : 400;
            vertical-alignment: center;
            overflow: elide;
            max-width: 180px;
        }

        // Description (muted)
        Text {
            text: app-description;
            color: OsvPalette.muted;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// MAIN LAUNCHER
// ============================================================================

export component IntakeLauncher inherits Window {
    // Search state
    in-out property <string> search-query;
    in property <[AppResult]> results: [];
    in-out property <int> selected-index: 0;

    // Callbacks
    callback search-changed(string);
    callback launch-selected();
    callback launch-at-index(int);
    callback close-launcher();
    callback navigate-up();
    callback navigate-down();

    title: "OSV-Intake";
    background: transparent;
    default-font-family: "Inter";
    default-font-size: 12px;

    // Dynamic height based on results
    width: 420px;
    height: 48px + Math.min(results.length, 8) * 32px + (results.length > 0 ? 8px : 0px);

    // Main container
    Rectangle {
        background: OsvPalette.black.with-alpha(0.95);
        border-radius: 8px;
        border-width: 1px;
        border-color: OsvPalette.border;

        // Drop shadow
        drop-shadow-color: #000000.with-alpha(0.5);
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 4px;

        VerticalLayout {
            padding: 8px;
            spacing: 4px;

            // Search input row
            Rectangle {
                height: 32px;
                background: OsvPalette.surface;
                border-radius: 4px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;

                    search-input := LineEdit {
                        font-size: 13px;
                        text <=> search-query;
                        placeholder-text: "Search applications...";

                        edited => {
                            search-changed(self.text);
                            selected-index = 0;
                        }

                        accepted => {
                            launch-selected();
                        }
                    }
                }
            }

            // Results list (max 8 visible)
            if results.length > 0: VerticalLayout {
                spacing: 2px;

                for result[idx] in results: AppResultItem {
                    app-name: result.name;
                    app-description: result.description;
                    is-selected: idx == selected-index;

                    clicked => {
                        selected-index = idx;
                        launch-at-index(idx);
                    }
                }
            }
        }
    }

    // Keyboard navigation
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-launcher();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                navigate-up();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                navigate-down();
                return accept;
            }
            return reject;
        }
    }

    // Focus on start
    init => {
        search-input.focus();
    }
}
