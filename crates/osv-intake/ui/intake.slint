// osv-intake - Application Launcher UI
// Minimal centered launcher: 450x100px

import { LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

// ============================================================================
// OSV COLOR PALETTE
// ============================================================================

struct OsvColors {
    black: color,
    dark: color,
    surface: color,
    border: color,
    muted: color,
    text: color,
    bright: color,
    accent-primary: color,
}

global OsvPalette {
    out property <OsvColors> colors: {
        black: #121216,
        dark: #1c1c22,
        surface: #26262e,
        border: #3a3a44,
        muted: #80808c,
        text: #dcdce4,
        bright: #f8f8fc,
        accent-primary: #58a6ff,
    };
}

// ============================================================================
// MAIN LAUNCHER WINDOW
// ============================================================================

export component IntakeLauncher inherits Window {
    // Properties
    in-out property <string> search-query;

    // Callbacks
    callback search-changed(string);
    callback launch-command(string);
    callback close-launcher();

    title: "OSV-Intake";
    background: transparent;
    default-font-family: "Inter";
    default-font-size: 14px;

    width: 450px;
    height: 100px;

    // Main container with rounded corners
    Rectangle {
        background: OsvPalette.colors.black.with-alpha(0.94);
        border-radius: 12px;
        border-width: 1px;
        border-color: OsvPalette.colors.border;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            alignment: center;

            // Title
            Text {
                text: "OSV-Intake";
                color: OsvPalette.colors.bright;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            // Search box
            Rectangle {
                height: 36px;
                background: OsvPalette.colors.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: OsvPalette.colors.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;

                    search-input := LineEdit {
                        font-size: 14px;
                        text <=> search-query;
                        placeholder-text: "Type command or search...";

                        edited => {
                            search-changed(self.text);
                        }

                        accepted => {
                            launch-command(self.text);
                        }
                    }
                }
            }
        }
    }

    // Keyboard handling
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-launcher();
                return accept;
            }
            return reject;
        }
    }

    // Focus search input on start
    init => {
        search-input.focus();
    }
}
