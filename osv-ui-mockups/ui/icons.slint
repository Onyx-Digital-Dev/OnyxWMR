// OSV Icon Components using SVG paths
// Lucide-style icons with 1.5px stroke

component IconBase {
    in property <string> path-data;
    in property <color> icon-color: #6b8ab0;
    in property <length> size: 16px;
    
    width: size;
    height: size;
    
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: icon-color;
        stroke-width: 1.5px;
        fill: transparent;
        commands: path-data;
    }
}

// Wifi icon
export component IconWifi inherits IconBase {
    path-data: "M12 20h.01 M2 8.82a15 15 0 0 1 20 0 M5 12.86a10 10 0 0 1 14 0 M8.5 16.43a5 5 0 0 1 7 0";
}

