// OSV Control Panel (osv-control)
// System settings panel with telemetry dashboard

import { OsvTheme } from "theme.slint";
import { OsvToggle, OsvSlider, OsvCard, OsvProgressBar, OsvDropdown } from "components.slint";
import { IconGauge, IconMonitor, IconVolume2, IconSpeaker, IconPower, IconZap, IconBluetooth, IconPalette, IconImage, IconInfo, IconUser, IconCpu, IconHardDrive, IconGlobe, IconActivity, IconArrowUp, IconArrowDown, IconRoute, IconWifi, IconShield, IconSun, IconMoon, IconBattery, IconBatteryCharging, IconClock, IconCalendar, IconMapPin, IconKeyboard, IconMouse, IconCheck, IconRefresh } from "icons.slint";

// Navigation section item
component NavItem {
    in property <string> label: "Section";
    in property <string> icon-type: "monitor";
    in property <bool> active: false;
    callback clicked();
    
    height: 36px;
    
    Rectangle {
        width: 100%;
        height: 100%;
        background: active ? OsvTheme.surface : transparent;
        
        // Active indicator
        if (active): Rectangle {
            x: 0;
            width: 2px;
            height: 100%;
            background: OsvTheme.accent;
        }
        
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: OsvTheme.space-sm;

            // Icon
            Rectangle {
                width: OsvTheme.icon-md;
                height: OsvTheme.icon-md;
                property <color> ic: active ? OsvTheme.text : OsvTheme.muted;

                if icon-type == "gauge": IconGauge { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "monitor": IconMonitor { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "volume": IconVolume2 { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "power": IconPower { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "bluetooth": IconBluetooth { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "palette": IconPalette { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "info": IconInfo { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "wifi": IconWifi { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "shield": IconShield { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "user": IconUser { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "battery": IconBattery { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "clock": IconClock { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "calendar": IconCalendar { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "keyboard": IconKeyboard { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "mouse": IconMouse { size: OsvTheme.icon-md; icon-color: ic; }
            }
            
            // Label
            Text {
                text: label;
                color: active ? OsvTheme.text : OsvTheme.muted;
                font-size: OsvTheme.font-body;
                vertical-alignment: center;
            }
        }
        
        animate background { duration: 100ms; }
    }
    
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Telemetry metric card
component TelemetryMetric {
    in property <string> label: "Metric";
    in property <string> value: "0";
    in property <string> unit: "";
    in property <float> bar-value: 0.5;
    in property <color> bar-color: OsvTheme.accent;
    in property <string> icon-type: "cpu";
    
    height: 72px;
    
    Rectangle {
        width: 100%;
        height: 100%;
        background: OsvTheme.surface;
        border-radius: OsvTheme.radius-md;
        border-width: 1px;
        border-color: OsvTheme.border;
        
        HorizontalLayout {
            padding: OsvTheme.space-sm;
            spacing: OsvTheme.space-sm;
            
            // Icon
            Rectangle {
                width: 32px;
                height: 32px;
                background: OsvTheme.dark;
                border-radius: OsvTheme.radius-sm;

                if icon-type == "cpu": IconCpu { x: 8px; y: 8px; size: OsvTheme.icon-md; icon-color: bar-color; }
                if icon-type == "memory": IconHardDrive { x: 8px; y: 8px; size: OsvTheme.icon-md; icon-color: bar-color; }
                if icon-type == "network": IconGlobe { x: 8px; y: 8px; size: OsvTheme.icon-md; icon-color: bar-color; }
                if icon-type == "upload": IconArrowUp { x: 8px; y: 8px; size: OsvTheme.icon-md; icon-color: bar-color; }
                if icon-type == "download": IconArrowDown { x: 8px; y: 8px; size: OsvTheme.icon-md; icon-color: bar-color; }
                if icon-type == "activity": IconActivity { x: 8px; y: 8px; size: OsvTheme.icon-md; icon-color: bar-color; }
                if icon-type == "disk": IconHardDrive { x: 8px; y: 8px; size: OsvTheme.icon-md; icon-color: bar-color; }
            }
            
            // Content
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                
                Text {
                    text: label;
                    color: OsvTheme.muted;
                    font-size: OsvTheme.font-label;
                }
                
                HorizontalLayout {
                    Text {
                        text: value;
                        color: OsvTheme.bright;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Text {
                        text: " " + unit;
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-body;
                        vertical-alignment: bottom;
                    }
                }
                
                // Progress bar
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: OsvTheme.dark;
                    
                    Rectangle {
                        width: parent.width * clamp(bar-value, 0.0, 1.0);
                        height: 100%;
                        border-radius: 2px;
                        background: bar-color;
                    }
                }
            }
        }
    }
}

// Route/Process item
component RouteItem {
    in property <string> name: "Process";
    in property <string> status: "running";
    in property <string> cpu: "0%";
    in property <string> memory: "0 MB";
    
    height: 32px;
    
    Rectangle {
        width: 100%;
        height: 100%;
        
        HorizontalLayout {
            padding-left: OsvTheme.space-sm;
            padding-right: OsvTheme.space-sm;
            spacing: OsvTheme.space-md;
            
            // Status dot
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: status == "running" ? OsvTheme.success : (status == "idle" ? OsvTheme.muted : OsvTheme.error);
            }
            
            // Name
            Text {
                text: name;
                color: OsvTheme.text;
                font-size: OsvTheme.font-body;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            
            // CPU
            Text {
                text: cpu;
                color: OsvTheme.muted;
                font-size: OsvTheme.font-label;
                vertical-alignment: center;
                width: 48px;
                horizontal-alignment: right;
            }
            
            // Memory
            Text {
                text: memory;
                color: OsvTheme.muted;
                font-size: OsvTheme.font-label;
                vertical-alignment: center;
                width: 64px;
                horizontal-alignment: right;
            }
        }
    }
}

// Main Control Panel Component  
export component OsvControl {
    in property <int> active-section: 0; // 0 = Telemetry (default), 1 = Network, 2 = Display, etc.
    
    // Telemetry data
    in property <float> cpu-usage: 0.42;
    in property <float> memory-usage: 0.67;
    in property <float> disk-usage: 0.35;
    in property <string> network-up: "1.2";
    in property <string> network-down: "15.8";
    
    // Display settings
    in property <float> brightness: 0.8;
    in property <bool> night-mode: false;
    in property <string> resolution: "1920x1080";

    // Battery data
    in property <int> battery-percentage: 85;
    in property <bool> battery-charging: false;
    in property <string> battery-state: "Discharging";
    in property <string> battery-time-remaining: "3h 45m";
    in property <int> battery-health: 92;
    in property <string> battery-technology: "Li-ion";
    in property <string> battery-manufacturer: "Unknown";
    in property <int> battery-cycle-count: 342;

    // Date & Time data
    in property <string> current-date: "Monday, January 6, 2025";
    in property <string> current-time: "14:30";
    in property <string> timezone: "America/New_York";
    in property <string> timezone-offset: "UTC-05:00";
    in property <bool> use-24h-format: true;
    in property <bool> ntp-enabled: true;
    in property <bool> ntp-synchronized: true;

    // Keyboard data
    in property <string> keyboard-layout: "English (US)";
    in property <string> keyboard-variant: "Default";
    in property <int> key-repeat-delay: 500;
    in property <int> key-repeat-rate: 25;
    in property <bool> caps-lock-indicator: true;

    // Mouse/Touchpad data
    in property <float> mouse-speed: 0.5;
    in property <bool> mouse-natural-scroll: false;
    in property <bool> mouse-left-handed: false;
    in property <float> touchpad-speed: 0.5;
    in property <bool> touchpad-tap-to-click: true;
    in property <bool> touchpad-natural-scroll: true;
    in property <bool> touchpad-two-finger-scroll: true;

    callback section-changed(int);
    callback brightness-changed(float);
    callback night-mode-toggled(bool);
    callback time-format-toggled(bool);
    callback ntp-toggled(bool);
    callback key-repeat-delay-changed(int);
    callback key-repeat-rate-changed(int);
    callback mouse-speed-changed(float);
    callback natural-scroll-toggled(bool);
    callback tap-to-click-toggled(bool);
    callback touchpad-speed-changed(float);
    
    width: 800px;
    height: 600px;
    
    Rectangle {
        width: 100%;
        height: 100%;
        background: OsvTheme.osv-bg;
        border-radius: OsvTheme.radius-lg;
        border-width: 1px;
        border-color: OsvTheme.border;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: rgba(0, 0, 0, 0.5);
        clip: true;
        
        HorizontalLayout {
            // Left sidebar navigation
            Rectangle {
                width: 200px;
                background: OsvTheme.dark;
                
                VerticalLayout {
                    padding-top: OsvTheme.space-md;
                    spacing: 2px;
                    
                    // Section header
                    Text {
                        text: "SYSTEM";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                        horizontal-alignment: left;
                        x: 12px;
                    }
                    
                    Rectangle { height: 8px; }
                    
                    NavItem {
                        label: "Telemetry";
                        icon-type: "gauge";
                        active: active-section == 0;
                        clicked => { section-changed(0); }
                    }
                    
                    NavItem {
                        label: "Network";
                        icon-type: "wifi";
                        active: active-section == 1;
                        clicked => { section-changed(1); }
                    }
                    
                    NavItem {
                        label: "Display";
                        icon-type: "monitor";
                        active: active-section == 2;
                        clicked => { section-changed(2); }
                    }
                    
                    NavItem {
                        label: "Sound";
                        icon-type: "volume";
                        active: active-section == 3;
                        clicked => { section-changed(3); }
                    }
                    
                    NavItem {
                        label: "Power";
                        icon-type: "power";
                        active: active-section == 4;
                        clicked => { section-changed(4); }
                    }

                    NavItem {
                        label: "Battery";
                        icon-type: "battery";
                        active: active-section == 5;
                        clicked => { section-changed(5); }
                    }

                    NavItem {
                        label: "Date & Time";
                        icon-type: "calendar";
                        active: active-section == 6;
                        clicked => { section-changed(6); }
                    }

                    NavItem {
                        label: "Keyboard";
                        icon-type: "keyboard";
                        active: active-section == 7;
                        clicked => { section-changed(7); }
                    }

                    NavItem {
                        label: "Mouse";
                        icon-type: "mouse";
                        active: active-section == 8;
                        clicked => { section-changed(8); }
                    }

                    NavItem {
                        label: "Bluetooth";
                        icon-type: "bluetooth";
                        active: active-section == 9;
                        clicked => { section-changed(9); }
                    }

                    NavItem {
                        label: "Appearance";
                        icon-type: "palette";
                        active: active-section == 10;
                        clicked => { section-changed(10); }
                    }

                    NavItem {
                        label: "About";
                        icon-type: "info";
                        active: active-section == 11;
                        clicked => { section-changed(11); }
                    }
                    
                    // Spacer
                    Rectangle { vertical-stretch: 1; }
                }
            }
            
            // Right content area
            Rectangle {
                horizontal-stretch: 1;
                background: OsvTheme.osv-bg;
                
                // Telemetry Dashboard (Section 0)
                if (active-section == 0): VerticalLayout {
                    padding: OsvTheme.space-md;
                    spacing: OsvTheme.space-md;
                    
                    // Header
                    Text {
                        text: "SYSTEM TELEMETRY";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                    }
                    
                    // Metrics grid
                    HorizontalLayout {
                        spacing: OsvTheme.space-sm;

                        TelemetryMetric {
                            horizontal-stretch: 1;
                            label: "CPU Usage";
                            value: "\{round(cpu-usage * 100)}";
                            unit: "%";
                            bar-value: cpu-usage;
                            bar-color: cpu-usage > 0.8 ? OsvTheme.error : (cpu-usage > 0.6 ? OsvTheme.warning : OsvTheme.accent);
                            icon-type: "cpu";
                        }

                        TelemetryMetric {
                            horizontal-stretch: 1;
                            label: "Memory";
                            value: "\{round(memory-usage * 100)}";
                            unit: "%";
                            bar-value: memory-usage;
                            bar-color: memory-usage > 0.8 ? OsvTheme.error : (memory-usage > 0.6 ? OsvTheme.warning : OsvTheme.accent);
                            icon-type: "memory";
                        }

                        TelemetryMetric {
                            horizontal-stretch: 1;
                            label: "Disk";
                            value: "\{round(disk-usage * 100)}";
                            unit: "%";
                            bar-value: disk-usage;
                            bar-color: OsvTheme.success;
                            icon-type: "disk";
                        }
                    }

                    // Network throughput
                    HorizontalLayout {
                        spacing: OsvTheme.space-sm;

                        TelemetryMetric {
                            horizontal-stretch: 1;
                            label: "Network Upload";
                            value: network-up;
                            unit: "MB/s";
                            bar-value: 0.3;
                            bar-color: OsvTheme.accent;
                            icon-type: "upload";
                        }
                        
                        TelemetryMetric {
                            horizontal-stretch: 1;
                            label: "Network Download";
                            value: network-down;
                            unit: "MB/s";
                            bar-value: 0.65;
                            bar-color: OsvTheme.accent;
                            icon-type: "download";
                        }
                    }
                    
                    // Routes/Processes section
                    Rectangle {
                        vertical-stretch: 1;
                        
                        VerticalLayout {
                            spacing: OsvTheme.space-sm;
                            
                            // Header
                            HorizontalLayout {
                                Text {
                                    text: "ACTIVE ROUTES";
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-label;
                                    letter-spacing: 1px;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                IconRoute {
                                    size: 14px;
                                    icon-color: OsvTheme.muted;
                                }
                            }
                            
                            // Process list card
                            Rectangle {
                                vertical-stretch: 1;
                                background: OsvTheme.surface;
                                border-radius: OsvTheme.radius-md;
                                border-width: 1px;
                                border-color: OsvTheme.border;
                                
                                VerticalLayout {
                                    padding: OsvTheme.space-sm;
                                    spacing: 0;
                                    
                                    // Column headers
                                    Rectangle {
                                        height: 24px;
                                        
                                        HorizontalLayout {
                                            padding-left: OsvTheme.space-sm;
                                            padding-right: OsvTheme.space-sm;
                                            spacing: OsvTheme.space-md;
                                            
                                            Rectangle { width: 8px; }
                                            Text {
                                                text: "PROCESS";
                                                color: OsvTheme.muted;
                                                font-size: 10px;
                                                letter-spacing: 0.5px;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: "CPU";
                                                color: OsvTheme.muted;
                                                font-size: 10px;
                                                letter-spacing: 0.5px;
                                                width: 48px;
                                                horizontal-alignment: right;
                                            }
                                            Text {
                                                text: "MEM";
                                                color: OsvTheme.muted;
                                                font-size: 10px;
                                                letter-spacing: 0.5px;
                                                width: 64px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                    
                                    // Process rows
                                    RouteItem { name: "osvwm"; status: "running"; cpu: "2.4%"; memory: "128 MB"; }
                                    RouteItem { name: "osv-bar"; status: "running"; cpu: "0.8%"; memory: "24 MB"; }
                                    RouteItem { name: "firefox"; status: "running"; cpu: "12.3%"; memory: "1.2 GB"; }
                                    RouteItem { name: "alacritty"; status: "running"; cpu: "0.2%"; memory: "48 MB"; }
                                    RouteItem { name: "pipewire"; status: "running"; cpu: "1.1%"; memory: "32 MB"; }
                                    RouteItem { name: "dbus-daemon"; status: "idle"; cpu: "0.0%"; memory: "8 MB"; }
                                }
                            }
                        }
                    }
                }
                
                // Display Settings (Section 2)
                if (active-section == 2): VerticalLayout {
                    padding: OsvTheme.space-md;
                    spacing: OsvTheme.space-md;
                    
                    // Header
                    Text {
                        text: "DISPLAY";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                    }
                    
                    // Brightness card
                    OsvCard {
                        title: "BRIGHTNESS";
                        
                        HorizontalLayout {
                            spacing: OsvTheme.space-md;
                            
                            IconMonitor {
                                size: 20px;
                                icon-color: OsvTheme.muted;
                            }
                            
                            OsvSlider {
                                horizontal-stretch: 1;
                                value: brightness;
                                changed(v) => { brightness-changed(v); }
                            }
                            
                            Text {
                                text: "\{round(brightness * 100)}%";
                                color: OsvTheme.text;
                                font-size: OsvTheme.font-body;
                                width: 48px;
                                horizontal-alignment: right;
                            }
                        }
                    }
                    
                    // Night mode card
                    OsvCard {
                        title: "NIGHT MODE";
                        
                        HorizontalLayout {
                            spacing: OsvTheme.space-md;
                            
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                
                                Text {
                                    text: "Reduce blue light";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                }
                                Text {
                                    text: "Easier on your eyes at night";
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-label;
                                }
                            }
                            
                            OsvToggle {
                                checked: night-mode;
                                toggled(v) => { night-mode-toggled(v); }
                            }
                        }
                    }
                    
                    // Resolution card
                    OsvCard {
                        title: "RESOLUTION";
                        
                        HorizontalLayout {
                            spacing: OsvTheme.space-md;
                            
                            Text {
                                text: "Display resolution";
                                color: OsvTheme.text;
                                font-size: OsvTheme.font-body;
                                horizontal-stretch: 1;
                            }
                            
                            OsvDropdown {
                                width: 140px;
                                current-value: resolution;
                                options: ["1920x1080", "2560x1440", "3840x2160"];
                            }
                        }
                    }
                    
                    // Display info card
                    OsvCard {
                        title: "DISPLAY INFO";
                        
                        VerticalLayout {
                            spacing: 8px;
                            
                            HorizontalLayout {
                                Text { text: "Model"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: "Generic Display"; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }
                            
                            HorizontalLayout {
                                Text { text: "Resolution"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: resolution; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }
                            
                            HorizontalLayout {
                                Text { text: "Refresh Rate"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: "60 Hz"; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }
                        }
                    }
                    
                    // Spacer
                    Rectangle { vertical-stretch: 1; }
                }
                
                // Battery section (Section 5)
                if active-section == 5: VerticalLayout {
                    padding: OsvTheme.space-md;
                    spacing: OsvTheme.space-md;

                    Text {
                        text: "BATTERY";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                    }

                    // Main battery status card
                    OsvCard {
                        title: "STATUS";

                        HorizontalLayout {
                            spacing: OsvTheme.space-lg;

                            // Battery icon and percentage
                            VerticalLayout {
                                spacing: OsvTheme.space-sm;
                                horizontal-stretch: 0;

                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    background: OsvTheme.dark;
                                    border-radius: OsvTheme.radius-lg;

                                    if battery-charging: IconBatteryCharging {
                                        x: 16px;
                                        y: 16px;
                                        size: 32px;
                                        icon-color: OsvTheme.success;
                                    }
                                    if !battery-charging: IconBattery {
                                        x: 16px;
                                        y: 16px;
                                        size: 32px;
                                        icon-color: battery-percentage < 20 ? OsvTheme.error :
                                                    battery-percentage < 50 ? OsvTheme.warning : OsvTheme.accent;
                                    }
                                }
                            }

                            // Battery details
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: OsvTheme.space-xs;

                                HorizontalLayout {
                                    Text {
                                        text: "\{battery-percentage}%";
                                        color: OsvTheme.bright;
                                        font-size: 28px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: battery-charging ? " Charging" : " " + battery-state;
                                        color: OsvTheme.muted;
                                        font-size: OsvTheme.font-body;
                                        vertical-alignment: bottom;
                                    }
                                }

                                // Progress bar
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: OsvTheme.dark;

                                    Rectangle {
                                        width: parent.width * (battery-percentage / 100.0);
                                        height: 100%;
                                        border-radius: 4px;
                                        background: battery-percentage < 20 ? OsvTheme.error :
                                                    battery-percentage < 50 ? OsvTheme.warning :
                                                    battery-charging ? OsvTheme.success : OsvTheme.accent;
                                    }
                                }

                                Text {
                                    text: battery-charging ? "Time to full: " + battery-time-remaining :
                                          "Time remaining: " + battery-time-remaining;
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-label;
                                }
                            }
                        }
                    }

                    // Battery health card
                    OsvCard {
                        title: "HEALTH";

                        VerticalLayout {
                            spacing: OsvTheme.space-sm;

                            HorizontalLayout {
                                Text { text: "Battery Health"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text {
                                    text: "\{battery-health}%";
                                    color: battery-health >= 80 ? OsvTheme.success :
                                           battery-health >= 50 ? OsvTheme.warning : OsvTheme.error;
                                    font-size: OsvTheme.font-body;
                                    font-weight: 600;
                                }
                            }

                            HorizontalLayout {
                                Text { text: "Cycle Count"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: "\{battery-cycle-count}"; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }

                            HorizontalLayout {
                                Text { text: "Technology"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: battery-technology; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }

                            HorizontalLayout {
                                Text { text: "Manufacturer"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: battery-manufacturer; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // Date & Time section (Section 6)
                if active-section == 6: VerticalLayout {
                    padding: OsvTheme.space-md;
                    spacing: OsvTheme.space-md;

                    Text {
                        text: "DATE & TIME";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                    }

                    // Current time display card
                    OsvCard {
                        title: "CURRENT TIME";

                        VerticalLayout {
                            spacing: OsvTheme.space-sm;

                            HorizontalLayout {
                                spacing: OsvTheme.space-lg;

                                // Large clock icon
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    background: OsvTheme.dark;
                                    border-radius: OsvTheme.radius-lg;

                                    IconClock {
                                        x: 16px;
                                        y: 16px;
                                        size: 32px;
                                        icon-color: OsvTheme.accent;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: OsvTheme.space-xs;

                                    Text {
                                        text: current-time;
                                        color: OsvTheme.bright;
                                        font-size: 32px;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: current-date;
                                        color: OsvTheme.muted;
                                        font-size: OsvTheme.font-body;
                                    }
                                }
                            }
                        }
                    }

                    // Timezone card
                    OsvCard {
                        title: "TIMEZONE";

                        VerticalLayout {
                            spacing: OsvTheme.space-sm;

                            HorizontalLayout {
                                spacing: OsvTheme.space-md;

                                IconMapPin {
                                    size: 20px;
                                    icon-color: OsvTheme.muted;
                                }

                                Text {
                                    text: timezone;
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: timezone-offset;
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Time format card
                    OsvCard {
                        title: "FORMAT";

                        VerticalLayout {
                            spacing: OsvTheme.space-md;

                            HorizontalLayout {
                                Text {
                                    text: "Use 24-hour format";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                OsvToggle {
                                    checked: use-24h-format;
                                    toggled(v) => { time-format-toggled(v); }
                                }
                            }
                        }
                    }

                    // NTP synchronization card
                    OsvCard {
                        title: "AUTOMATIC DATE & TIME";

                        VerticalLayout {
                            spacing: OsvTheme.space-md;

                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;

                                    Text {
                                        text: "Network Time Synchronization";
                                        color: OsvTheme.text;
                                        font-size: OsvTheme.font-body;
                                    }
                                    Text {
                                        text: ntp-synchronized ? "Synchronized" : "Not synchronized";
                                        color: ntp-synchronized ? OsvTheme.success : OsvTheme.warning;
                                        font-size: OsvTheme.font-label;
                                    }
                                }

                                OsvToggle {
                                    checked: ntp-enabled;
                                    toggled(v) => { ntp-toggled(v); }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // Keyboard section (Section 7)
                if active-section == 7: VerticalLayout {
                    padding: OsvTheme.space-md;
                    spacing: OsvTheme.space-md;

                    Text {
                        text: "KEYBOARD";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                    }

                    // Layout card
                    OsvCard {
                        title: "LAYOUT";

                        VerticalLayout {
                            spacing: OsvTheme.space-sm;

                            HorizontalLayout {
                                Text { text: "Layout"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: keyboard-layout; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }

                            HorizontalLayout {
                                Text { text: "Variant"; color: OsvTheme.muted; font-size: OsvTheme.font-body; horizontal-stretch: 1; }
                                Text { text: keyboard-variant; color: OsvTheme.text; font-size: OsvTheme.font-body; }
                            }
                        }
                    }

                    // Key repeat card
                    OsvCard {
                        title: "KEY REPEAT";

                        VerticalLayout {
                            spacing: OsvTheme.space-md;

                            HorizontalLayout {
                                spacing: OsvTheme.space-md;

                                Text {
                                    text: "Delay";
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-body;
                                    width: 60px;
                                }

                                OsvSlider {
                                    horizontal-stretch: 1;
                                    value: key-repeat-delay / 1000.0;
                                    min: 0.1;
                                    max: 1.0;
                                }

                                Text {
                                    text: "\{key-repeat-delay}ms";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    width: 60px;
                                    horizontal-alignment: right;
                                }
                            }

                            HorizontalLayout {
                                spacing: OsvTheme.space-md;

                                Text {
                                    text: "Rate";
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-body;
                                    width: 60px;
                                }

                                OsvSlider {
                                    horizontal-stretch: 1;
                                    value: key-repeat-rate / 50.0;
                                    min: 0.1;
                                    max: 1.0;
                                }

                                Text {
                                    text: "\{key-repeat-rate}/s";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    width: 60px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }

                    // Options card
                    OsvCard {
                        title: "OPTIONS";

                        VerticalLayout {
                            spacing: OsvTheme.space-md;

                            HorizontalLayout {
                                Text {
                                    text: "Caps Lock indicator";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                OsvToggle {
                                    checked: caps-lock-indicator;
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // Mouse/Touchpad section (Section 8)
                if active-section == 8: VerticalLayout {
                    padding: OsvTheme.space-md;
                    spacing: OsvTheme.space-md;

                    Text {
                        text: "MOUSE & TOUCHPAD";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                    }

                    // Mouse card
                    OsvCard {
                        title: "MOUSE";

                        VerticalLayout {
                            spacing: OsvTheme.space-md;

                            HorizontalLayout {
                                spacing: OsvTheme.space-md;

                                Text {
                                    text: "Speed";
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-body;
                                    width: 80px;
                                }

                                OsvSlider {
                                    horizontal-stretch: 1;
                                    value: mouse-speed;
                                    changed(v) => { mouse-speed-changed(v); }
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "Natural scrolling";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                OsvToggle {
                                    checked: mouse-natural-scroll;
                                    toggled(v) => { natural-scroll-toggled(v); }
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "Left-handed mode";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                OsvToggle {
                                    checked: mouse-left-handed;
                                }
                            }
                        }
                    }

                    // Touchpad card
                    OsvCard {
                        title: "TOUCHPAD";

                        VerticalLayout {
                            spacing: OsvTheme.space-md;

                            HorizontalLayout {
                                spacing: OsvTheme.space-md;

                                Text {
                                    text: "Speed";
                                    color: OsvTheme.muted;
                                    font-size: OsvTheme.font-body;
                                    width: 80px;
                                }

                                OsvSlider {
                                    horizontal-stretch: 1;
                                    value: touchpad-speed;
                                    changed(v) => { touchpad-speed-changed(v); }
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "Tap to click";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                OsvToggle {
                                    checked: touchpad-tap-to-click;
                                    toggled(v) => { tap-to-click-toggled(v); }
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "Natural scrolling";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                OsvToggle {
                                    checked: touchpad-natural-scroll;
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "Two-finger scroll";
                                    color: OsvTheme.text;
                                    font-size: OsvTheme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                OsvToggle {
                                    checked: touchpad-two-finger-scroll;
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // Placeholder for remaining sections
                if active-section != 0 && active-section != 2 && active-section != 5 && active-section != 6 && active-section != 7 && active-section != 8: VerticalLayout {
                    padding: OsvTheme.space-md;

                    Text {
                        text: active-section == 1 ? "NETWORK" :
                              active-section == 3 ? "SOUND" :
                              active-section == 4 ? "POWER" :
                              active-section == 9 ? "BLUETOOTH" :
                              active-section == 10 ? "APPEARANCE" :
                              "ABOUT";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-label;
                        letter-spacing: 1px;
                    }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "Settings panel content";
                        color: OsvTheme.muted;
                        font-size: OsvTheme.font-body;
                        horizontal-alignment: center;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}

// Preview/Export component
export component OsvControlWindow inherits Window {
    title: "osv-control";
    width: 800px;
    height: 600px;
    background: #0a1628;
    
    OsvControl {
        active-section: 0; // Start on Telemetry dashboard
        cpu-usage: 0.42;
        memory-usage: 0.67;
        disk-usage: 0.35;
        network-up: "1.2";
        network-down: "15.8";
        brightness: 0.8;
        night-mode: false;
        resolution: "1920x1080";
        battery-percentage: 72;
        battery-charging: false;
        battery-state: "Discharging";
        battery-time-remaining: "2h 45m";
        battery-health: 89;
        battery-technology: "Li-ion";
        battery-manufacturer: "Samsung SDI";
        battery-cycle-count: 287;
        current-date: "Monday, January 6, 2025";
        current-time: "14:30";
        timezone: "America/New_York";
        timezone-offset: "UTC-05:00";
        use-24h-format: true;
        ntp-enabled: true;
        ntp-synchronized: true;
        keyboard-layout: "English (US)";
        keyboard-variant: "Default";
        key-repeat-delay: 500;
        key-repeat-rate: 25;
        caps-lock-indicator: true;
        mouse-speed: 0.5;
        mouse-natural-scroll: false;
        mouse-left-handed: false;
        touchpad-speed: 0.5;
        touchpad-tap-to-click: true;
        touchpad-natural-scroll: true;
        touchpad-two-finger-scroll: true;
    }
}
