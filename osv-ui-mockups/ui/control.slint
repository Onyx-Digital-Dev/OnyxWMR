// OSV Control Panel (osv-control)
// System settings panel with telemetry dashboard

import { OsvTheme } from "theme.slint";
import { OsvToggle, OsvSlider, OsvCard, OsvProgressBar, OsvDropdown } from "components.slint";
import { IconGauge, IconMonitor, IconVolume2, IconSpeaker, IconPower, IconZap, IconBluetooth, IconPalette, IconImage, IconInfo, IconUser, IconCpu, IconHardDrive, IconGlobe, IconActivity, IconArrowUp, IconArrowDown, IconRoute, IconWifi, IconShield, IconSun, IconMoon, IconBattery, IconBatteryCharging, IconClock, IconCalendar, IconMapPin, IconKeyboard, IconMouse, IconCheck, IconRefresh } from "icons.slint";

// Compact navigation item
component NavItem {
    in property <string> label: "Section";
    in property <string> icon-type: "monitor";
    in property <bool> active: false;
    callback clicked();

    height: 32px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: active ? OsvTheme.surface : transparent;
        border-radius: active ? OsvTheme.radius-sm : 0;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;

            // Icon
            Rectangle {
                width: 16px;
                height: 16px;
                property <color> ic: active ? OsvTheme.accent : OsvTheme.muted;

                if icon-type == "gauge": IconGauge { size: 16px; icon-color: ic; }
                if icon-type == "monitor": IconMonitor { size: 16px; icon-color: ic; }
                if icon-type == "volume": IconVolume2 { size: 16px; icon-color: ic; }
                if icon-type == "power": IconPower { size: 16px; icon-color: ic; }
                if icon-type == "bluetooth": IconBluetooth { size: 16px; icon-color: ic; }
                if icon-type == "palette": IconPalette { size: 16px; icon-color: ic; }
                if icon-type == "info": IconInfo { size: 16px; icon-color: ic; }
                if icon-type == "wifi": IconWifi { size: 16px; icon-color: ic; }
                if icon-type == "shield": IconShield { size: 16px; icon-color: ic; }
                if icon-type == "user": IconUser { size: 16px; icon-color: ic; }
                if icon-type == "battery": IconBattery { size: 16px; icon-color: ic; }
                if icon-type == "clock": IconClock { size: 16px; icon-color: ic; }
                if icon-type == "calendar": IconCalendar { size: 16px; icon-color: ic; }
                if icon-type == "keyboard": IconKeyboard { size: 16px; icon-color: ic; }
                if icon-type == "mouse": IconMouse { size: 16px; icon-color: ic; }
            }

            // Label
            Text {
                text: label;
                color: active ? OsvTheme.text : OsvTheme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        animate background { duration: 100ms; }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Navigation section header
component NavSection {
    in property <string> title: "SECTION";

    height: 24px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: title;
            color: OsvTheme.muted.with-alpha(0.6);
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }
}

// Compact metric card for telemetry
component MetricCard {
    in property <string> label: "Metric";
    in property <string> value: "0";
    in property <string> unit: "";
    in property <float> bar-value: 0.5;
    in property <color> bar-color: OsvTheme.accent;
    in property <string> icon-type: "cpu";

    Rectangle {
        width: 100%;
        height: 100%;
        background: OsvTheme.surface;
        border-radius: OsvTheme.radius-md;
        border-width: 1px;
        border-color: OsvTheme.border;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                // Icon
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: OsvTheme.dark;
                    border-radius: 6px;

                    if icon-type == "cpu": IconCpu { x: 6px; y: 6px; size: 16px; icon-color: bar-color; }
                    if icon-type == "memory": IconHardDrive { x: 6px; y: 6px; size: 16px; icon-color: bar-color; }
                    if icon-type == "disk": IconHardDrive { x: 6px; y: 6px; size: 16px; icon-color: bar-color; }
                    if icon-type == "upload": IconArrowUp { x: 6px; y: 6px; size: 16px; icon-color: bar-color; }
                    if icon-type == "download": IconArrowDown { x: 6px; y: 6px; size: 16px; icon-color: bar-color; }
                    if icon-type == "activity": IconActivity { x: 6px; y: 6px; size: 16px; icon-color: bar-color; }
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: label;
                        color: OsvTheme.muted;
                        font-size: 10px;
                    }

                    HorizontalLayout {
                        Text {
                            text: value;
                            color: OsvTheme.bright;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: unit;
                            color: OsvTheme.muted;
                            font-size: 11px;
                            vertical-alignment: bottom;
                        }
                    }
                }
            }

            // Progress bar
            Rectangle {
                height: 3px;
                border-radius: 2px;
                background: OsvTheme.dark;

                Rectangle {
                    width: parent.width * clamp(bar-value, 0.0, 1.0);
                    height: 100%;
                    border-radius: 2px;
                    background: bar-color;
                }
            }
        }
    }
}

// Settings row component
component SettingRow {
    in property <string> label: "Setting";
    in property <string> description: "";

    min-height: description == "" ? 36px : 48px;

    HorizontalLayout {
        spacing: OsvTheme.space-md;

        VerticalLayout {
            horizontal-stretch: 1;
            vertical-alignment: center;
            spacing: 2px;

            Text {
                text: label;
                color: OsvTheme.text;
                font-size: 13px;
            }

            if description != "": Text {
                text: description;
                color: OsvTheme.muted;
                font-size: 11px;
            }
        }

        @children
    }
}

// Route/Process item
component RouteItem {
    in property <string> name: "Process";
    in property <string> status: "running";
    in property <string> cpu: "0%";
    in property <string> memory: "0 MB";

    height: 28px;

    HorizontalLayout {
        spacing: 12px;

        // Status dot
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: status == "running" ? OsvTheme.success : (status == "idle" ? OsvTheme.muted : OsvTheme.error);
        }

        Text {
            text: name;
            color: OsvTheme.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: cpu;
            color: OsvTheme.muted;
            font-size: 11px;
            vertical-alignment: center;
            width: 40px;
            horizontal-alignment: right;
        }

        Text {
            text: memory;
            color: OsvTheme.muted;
            font-size: 11px;
            vertical-alignment: center;
            width: 56px;
            horizontal-alignment: right;
        }
    }
}

// Section content card
component SectionCard {
    in property <string> title: "";

    Rectangle {
        width: 100%;
        height: 100%;
        background: OsvTheme.surface;
        border-radius: OsvTheme.radius-md;
        border-width: 1px;
        border-color: OsvTheme.border;

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            if title != "": Text {
                text: title;
                color: OsvTheme.muted;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
            }

            @children
        }
    }
}

// Main Control Panel Component
export component OsvControl {
    in property <int> active-section: 0;

    // Telemetry data
    in property <float> cpu-usage: 0.42;
    in property <float> memory-usage: 0.67;
    in property <float> disk-usage: 0.35;
    in property <string> network-up: "1.2";
    in property <string> network-down: "15.8";

    // Display settings
    in property <float> brightness: 0.8;
    in property <bool> night-mode: false;
    in property <string> resolution: "1920x1080";

    // Battery data
    in property <int> battery-percentage: 85;
    in property <bool> battery-charging: false;
    in property <string> battery-state: "Discharging";
    in property <string> battery-time-remaining: "3h 45m";
    in property <int> battery-health: 92;
    in property <string> battery-technology: "Li-ion";
    in property <string> battery-manufacturer: "Unknown";
    in property <int> battery-cycle-count: 342;

    // Date & Time data
    in property <string> current-date: "Monday, January 6, 2025";
    in property <string> current-time: "14:30";
    in property <string> timezone: "America/New_York";
    in property <string> timezone-offset: "UTC-05:00";
    in property <bool> use-24h-format: true;
    in property <bool> ntp-enabled: true;
    in property <bool> ntp-synchronized: true;

    // Keyboard data
    in property <string> keyboard-layout: "English (US)";
    in property <string> keyboard-variant: "Default";
    in property <int> key-repeat-delay: 500;
    in property <int> key-repeat-rate: 25;
    in property <bool> caps-lock-indicator: true;

    // Mouse/Touchpad data
    in property <float> mouse-speed: 0.5;
    in property <bool> mouse-natural-scroll: false;
    in property <bool> mouse-left-handed: false;
    in property <float> touchpad-speed: 0.5;
    in property <bool> touchpad-tap-to-click: true;
    in property <bool> touchpad-natural-scroll: true;
    in property <bool> touchpad-two-finger-scroll: true;

    callback section-changed(int);
    callback brightness-changed(float);
    callback night-mode-toggled(bool);
    callback time-format-toggled(bool);
    callback ntp-toggled(bool);
    callback key-repeat-delay-changed(int);
    callback key-repeat-rate-changed(int);
    callback mouse-speed-changed(float);
    callback natural-scroll-toggled(bool);
    callback tap-to-click-toggled(bool);
    callback touchpad-speed-changed(float);

    width: 800px;
    height: 600px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: OsvTheme.osv-bg;
        border-radius: OsvTheme.radius-lg;
        border-width: 1px;
        border-color: OsvTheme.border;
        drop-shadow-blur: OsvTheme.shadow-panel-blur;
        drop-shadow-offset-y: OsvTheme.shadow-panel-offset-y;
        drop-shadow-color: rgba(0, 0, 0, OsvTheme.shadow-panel-opacity);
        clip: true;

        HorizontalLayout {
            // Left sidebar navigation
            Rectangle {
                width: 160px;
                background: OsvTheme.dark;

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;

                    // MONITORS
                    NavSection { title: "MONITORS"; }
                    NavItem { label: "Telemetry"; icon-type: "gauge"; active: active-section == 0; clicked => { section-changed(0); } }
                    NavItem { label: "Battery"; icon-type: "battery"; active: active-section == 5; clicked => { section-changed(5); } }

                    Rectangle { height: 8px; }

                    // DEVICES
                    NavSection { title: "DEVICES"; }
                    NavItem { label: "Display"; icon-type: "monitor"; active: active-section == 2; clicked => { section-changed(2); } }
                    NavItem { label: "Sound"; icon-type: "volume"; active: active-section == 3; clicked => { section-changed(3); } }
                    NavItem { label: "Keyboard"; icon-type: "keyboard"; active: active-section == 7; clicked => { section-changed(7); } }
                    NavItem { label: "Mouse"; icon-type: "mouse"; active: active-section == 8; clicked => { section-changed(8); } }
                    NavItem { label: "Bluetooth"; icon-type: "bluetooth"; active: active-section == 9; clicked => { section-changed(9); } }

                    Rectangle { height: 8px; }

                    // NETWORK
                    NavSection { title: "NETWORK"; }
                    NavItem { label: "Wi-Fi"; icon-type: "wifi"; active: active-section == 1; clicked => { section-changed(1); } }

                    Rectangle { height: 8px; }

                    // SYSTEM
                    NavSection { title: "SYSTEM"; }
                    NavItem { label: "Date & Time"; icon-type: "calendar"; active: active-section == 6; clicked => { section-changed(6); } }
                    NavItem { label: "Power"; icon-type: "power"; active: active-section == 4; clicked => { section-changed(4); } }
                    NavItem { label: "Appearance"; icon-type: "palette"; active: active-section == 10; clicked => { section-changed(10); } }
                    NavItem { label: "About"; icon-type: "info"; active: active-section == 11; clicked => { section-changed(11); } }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // Main content area
            Rectangle {
                horizontal-stretch: 1;
                background: OsvTheme.osv-bg;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // ═══════════════════════════════════════════════════════════
                    // TELEMETRY SECTION (0)
                    // ═══════════════════════════════════════════════════════════
                    if active-section == 0: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "System Telemetry";
                            color: OsvTheme.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        // Top row - 3 metrics
                        HorizontalLayout {
                            spacing: 10px;

                            MetricCard {
                                horizontal-stretch: 1;
                                label: "CPU";
                                value: "\{round(cpu-usage * 100)}";
                                unit: "%";
                                bar-value: cpu-usage;
                                bar-color: cpu-usage > 0.8 ? OsvTheme.error : (cpu-usage > 0.6 ? OsvTheme.warning : OsvTheme.accent);
                                icon-type: "cpu";
                            }

                            MetricCard {
                                horizontal-stretch: 1;
                                label: "Memory";
                                value: "\{round(memory-usage * 100)}";
                                unit: "%";
                                bar-value: memory-usage;
                                bar-color: memory-usage > 0.8 ? OsvTheme.error : (memory-usage > 0.6 ? OsvTheme.warning : OsvTheme.accent);
                                icon-type: "memory";
                            }

                            MetricCard {
                                horizontal-stretch: 1;
                                label: "Disk";
                                value: "\{round(disk-usage * 100)}";
                                unit: "%";
                                bar-value: disk-usage;
                                bar-color: OsvTheme.success;
                                icon-type: "disk";
                            }
                        }

                        // Second row - 2 network metrics
                        HorizontalLayout {
                            spacing: 10px;

                            MetricCard {
                                horizontal-stretch: 1;
                                label: "Upload";
                                value: network-up;
                                unit: " MB/s";
                                bar-value: 0.3;
                                bar-color: OsvTheme.accent;
                                icon-type: "upload";
                            }

                            MetricCard {
                                horizontal-stretch: 1;
                                label: "Download";
                                value: network-down;
                                unit: " MB/s";
                                bar-value: 0.65;
                                bar-color: OsvTheme.accent;
                                icon-type: "download";
                            }
                        }

                        // Processes list
                        SectionCard {
                            vertical-stretch: 1;
                            title: "ACTIVE PROCESSES";

                            VerticalLayout {
                                spacing: 4px;

                                // Column headers
                                HorizontalLayout {
                                    spacing: 12px;
                                    height: 20px;

                                    Rectangle { width: 6px; }
                                    Text { text: "NAME"; color: OsvTheme.muted.with-alpha(0.6); font-size: 9px; letter-spacing: 0.5px; horizontal-stretch: 1; }
                                    Text { text: "CPU"; color: OsvTheme.muted.with-alpha(0.6); font-size: 9px; letter-spacing: 0.5px; width: 40px; horizontal-alignment: right; }
                                    Text { text: "MEM"; color: OsvTheme.muted.with-alpha(0.6); font-size: 9px; letter-spacing: 0.5px; width: 56px; horizontal-alignment: right; }
                                }

                                RouteItem { name: "osvwm"; status: "running"; cpu: "2.4%"; memory: "128 MB"; }
                                RouteItem { name: "osv-bar"; status: "running"; cpu: "0.8%"; memory: "24 MB"; }
                                RouteItem { name: "firefox"; status: "running"; cpu: "12.3%"; memory: "1.2 GB"; }
                                RouteItem { name: "alacritty"; status: "running"; cpu: "0.2%"; memory: "48 MB"; }
                                RouteItem { name: "pipewire"; status: "running"; cpu: "1.1%"; memory: "32 MB"; }
                                RouteItem { name: "dbus-daemon"; status: "idle"; cpu: "0.0%"; memory: "8 MB"; }

                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }

                    // ═══════════════════════════════════════════════════════════
                    // DISPLAY SECTION (2)
                    // ═══════════════════════════════════════════════════════════
                    if active-section == 2: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Display";
                            color: OsvTheme.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        // Two-column layout
                        HorizontalLayout {
                            spacing: 12px;

                            // Left column
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 12px;

                                SectionCard {
                                    title: "BRIGHTNESS";

                                    HorizontalLayout {
                                        spacing: 12px;

                                        IconSun { size: 16px; icon-color: OsvTheme.muted; }

                                        OsvSlider {
                                            horizontal-stretch: 1;
                                            value: brightness;
                                            changed(v) => { brightness-changed(v); }
                                        }

                                        Text {
                                            text: "\{round(brightness * 100)}%";
                                            color: OsvTheme.text;
                                            font-size: 12px;
                                            width: 36px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }

                                SectionCard {
                                    title: "NIGHT MODE";

                                    SettingRow {
                                        label: "Reduce blue light";
                                        description: "Easier on your eyes at night";

                                        OsvToggle {
                                            checked: night-mode;
                                            toggled(v) => { night-mode-toggled(v); }
                                        }
                                    }
                                }
                            }

                            // Right column
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 12px;

                                SectionCard {
                                    title: "RESOLUTION";

                                    SettingRow {
                                        label: "Display resolution";

                                        OsvDropdown {
                                            width: 120px;
                                            current-value: resolution;
                                            options: ["1920x1080", "2560x1440", "3840x2160"];
                                        }
                                    }
                                }

                                SectionCard {
                                    title: "DISPLAY INFO";

                                    VerticalLayout {
                                        spacing: 8px;

                                        HorizontalLayout {
                                            Text { text: "Model"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                            Text { text: "Generic Display"; color: OsvTheme.text; font-size: 12px; }
                                        }

                                        HorizontalLayout {
                                            Text { text: "Refresh Rate"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                            Text { text: "60 Hz"; color: OsvTheme.text; font-size: 12px; }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // ═══════════════════════════════════════════════════════════
                    // BATTERY SECTION (5)
                    // ═══════════════════════════════════════════════════════════
                    if active-section == 5: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Battery";
                            color: OsvTheme.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        // Two-column layout
                        HorizontalLayout {
                            spacing: 12px;

                            // Left - Status
                            SectionCard {
                                horizontal-stretch: 1;
                                title: "STATUS";

                                VerticalLayout {
                                    spacing: 12px;

                                    HorizontalLayout {
                                        spacing: 16px;

                                        Rectangle {
                                            width: 56px;
                                            height: 56px;
                                            background: OsvTheme.dark;
                                            border-radius: OsvTheme.radius-lg;

                                            if battery-charging: IconBatteryCharging {
                                                x: 12px; y: 12px;
                                                size: 32px;
                                                icon-color: OsvTheme.success;
                                            }
                                            if !battery-charging: IconBattery {
                                                x: 12px; y: 12px;
                                                size: 32px;
                                                icon-color: battery-percentage < 20 ? OsvTheme.error :
                                                            battery-percentage < 50 ? OsvTheme.warning : OsvTheme.accent;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                Text {
                                                    text: "\{battery-percentage}%";
                                                    color: OsvTheme.bright;
                                                    font-size: 24px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: battery-charging ? " Charging" : " " + battery-state;
                                                    color: OsvTheme.muted;
                                                    font-size: 12px;
                                                    vertical-alignment: bottom;
                                                }
                                            }

                                            Rectangle {
                                                height: 6px;
                                                border-radius: 3px;
                                                background: OsvTheme.dark;

                                                Rectangle {
                                                    width: parent.width * (battery-percentage / 100.0);
                                                    height: 100%;
                                                    border-radius: 3px;
                                                    background: battery-percentage < 20 ? OsvTheme.error :
                                                                battery-percentage < 50 ? OsvTheme.warning :
                                                                battery-charging ? OsvTheme.success : OsvTheme.accent;
                                                }
                                            }

                                            Text {
                                                text: battery-charging ? "Full in " + battery-time-remaining : battery-time-remaining + " remaining";
                                                color: OsvTheme.muted;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }
                            }

                            // Right - Health
                            SectionCard {
                                horizontal-stretch: 1;
                                title: "HEALTH";

                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        Text { text: "Battery Health"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                        Text {
                                            text: "\{battery-health}%";
                                            color: battery-health >= 80 ? OsvTheme.success : battery-health >= 50 ? OsvTheme.warning : OsvTheme.error;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                    }

                                    HorizontalLayout {
                                        Text { text: "Cycle Count"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                        Text { text: "\{battery-cycle-count}"; color: OsvTheme.text; font-size: 12px; }
                                    }

                                    HorizontalLayout {
                                        Text { text: "Technology"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                        Text { text: battery-technology; color: OsvTheme.text; font-size: 12px; }
                                    }

                                    HorizontalLayout {
                                        Text { text: "Manufacturer"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                        Text { text: battery-manufacturer; color: OsvTheme.text; font-size: 12px; }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // ═══════════════════════════════════════════════════════════
                    // DATE & TIME SECTION (6)
                    // ═══════════════════════════════════════════════════════════
                    if active-section == 6: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Date & Time";
                            color: OsvTheme.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        // Two-column layout
                        HorizontalLayout {
                            spacing: 12px;

                            // Left column
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 12px;

                                SectionCard {
                                    title: "CURRENT TIME";

                                    HorizontalLayout {
                                        spacing: 16px;

                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            background: OsvTheme.dark;
                                            border-radius: OsvTheme.radius-md;

                                            IconClock {
                                                x: 12px; y: 12px;
                                                size: 24px;
                                                icon-color: OsvTheme.accent;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;

                                            Text {
                                                text: current-time;
                                                color: OsvTheme.bright;
                                                font-size: 28px;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: current-date;
                                                color: OsvTheme.muted;
                                                font-size: 12px;
                                            }
                                        }
                                    }
                                }

                                SectionCard {
                                    title: "TIMEZONE";

                                    HorizontalLayout {
                                        spacing: 10px;

                                        IconMapPin { size: 16px; icon-color: OsvTheme.muted; }

                                        Text {
                                            text: timezone;
                                            color: OsvTheme.text;
                                            font-size: 12px;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: timezone-offset;
                                            color: OsvTheme.muted;
                                            font-size: 12px;
                                        }
                                    }
                                }
                            }

                            // Right column
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 12px;

                                SectionCard {
                                    title: "FORMAT";

                                    SettingRow {
                                        label: "Use 24-hour format";

                                        OsvToggle {
                                            checked: use-24h-format;
                                            toggled(v) => { time-format-toggled(v); }
                                        }
                                    }
                                }

                                SectionCard {
                                    title: "AUTOMATIC";

                                    SettingRow {
                                        label: "Network time sync";
                                        description: ntp-synchronized ? "Synchronized" : "Not synchronized";

                                        OsvToggle {
                                            checked: ntp-enabled;
                                            toggled(v) => { ntp-toggled(v); }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // ═══════════════════════════════════════════════════════════
                    // KEYBOARD SECTION (7)
                    // ═══════════════════════════════════════════════════════════
                    if active-section == 7: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Keyboard";
                            color: OsvTheme.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        // Two-column layout
                        HorizontalLayout {
                            spacing: 12px;

                            // Left column
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 12px;

                                SectionCard {
                                    title: "LAYOUT";

                                    VerticalLayout {
                                        spacing: 8px;

                                        HorizontalLayout {
                                            Text { text: "Layout"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                            Text { text: keyboard-layout; color: OsvTheme.text; font-size: 12px; }
                                        }

                                        HorizontalLayout {
                                            Text { text: "Variant"; color: OsvTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                                            Text { text: keyboard-variant; color: OsvTheme.text; font-size: 12px; }
                                        }
                                    }
                                }

                                SectionCard {
                                    title: "OPTIONS";

                                    SettingRow {
                                        label: "Caps Lock indicator";

                                        OsvToggle { checked: caps-lock-indicator; }
                                    }
                                }
                            }

                            // Right column
                            SectionCard {
                                horizontal-stretch: 1;
                                title: "KEY REPEAT";

                                VerticalLayout {
                                    spacing: 16px;

                                    VerticalLayout {
                                        spacing: 6px;

                                        HorizontalLayout {
                                            Text { text: "Delay"; color: OsvTheme.muted; font-size: 11px; horizontal-stretch: 1; }
                                            Text { text: "\{key-repeat-delay}ms"; color: OsvTheme.text; font-size: 11px; }
                                        }

                                        OsvSlider {
                                            value: key-repeat-delay / 1000.0;
                                            min: 0.1;
                                            max: 1.0;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 6px;

                                        HorizontalLayout {
                                            Text { text: "Rate"; color: OsvTheme.muted; font-size: 11px; horizontal-stretch: 1; }
                                            Text { text: "\{key-repeat-rate}/s"; color: OsvTheme.text; font-size: 11px; }
                                        }

                                        OsvSlider {
                                            value: key-repeat-rate / 50.0;
                                            min: 0.1;
                                            max: 1.0;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // ═══════════════════════════════════════════════════════════
                    // MOUSE SECTION (8)
                    // ═══════════════════════════════════════════════════════════
                    if active-section == 8: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Mouse & Touchpad";
                            color: OsvTheme.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        // Two-column layout
                        HorizontalLayout {
                            spacing: 12px;

                            // Mouse
                            SectionCard {
                                horizontal-stretch: 1;
                                title: "MOUSE";

                                VerticalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        spacing: 6px;

                                        Text { text: "Speed"; color: OsvTheme.muted; font-size: 11px; }

                                        OsvSlider {
                                            value: mouse-speed;
                                            changed(v) => { mouse-speed-changed(v); }
                                        }
                                    }

                                    SettingRow {
                                        label: "Natural scrolling";

                                        OsvToggle {
                                            checked: mouse-natural-scroll;
                                            toggled(v) => { natural-scroll-toggled(v); }
                                        }
                                    }

                                    SettingRow {
                                        label: "Left-handed mode";

                                        OsvToggle { checked: mouse-left-handed; }
                                    }
                                }
                            }

                            // Touchpad
                            SectionCard {
                                horizontal-stretch: 1;
                                title: "TOUCHPAD";

                                VerticalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        spacing: 6px;

                                        Text { text: "Speed"; color: OsvTheme.muted; font-size: 11px; }

                                        OsvSlider {
                                            value: touchpad-speed;
                                            changed(v) => { touchpad-speed-changed(v); }
                                        }
                                    }

                                    SettingRow {
                                        label: "Tap to click";

                                        OsvToggle {
                                            checked: touchpad-tap-to-click;
                                            toggled(v) => { tap-to-click-toggled(v); }
                                        }
                                    }

                                    SettingRow {
                                        label: "Natural scrolling";

                                        OsvToggle { checked: touchpad-natural-scroll; }
                                    }

                                    SettingRow {
                                        label: "Two-finger scroll";

                                        OsvToggle { checked: touchpad-two-finger-scroll; }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // ═══════════════════════════════════════════════════════════
                    // PLACEHOLDER SECTIONS
                    // ═══════════════════════════════════════════════════════════
                    if active-section == 1 || active-section == 3 || active-section == 4 || active-section == 9 || active-section == 10 || active-section == 11: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: active-section == 1 ? "Wi-Fi" :
                                  active-section == 3 ? "Sound" :
                                  active-section == 4 ? "Power" :
                                  active-section == 9 ? "Bluetooth" :
                                  active-section == 10 ? "Appearance" : "About";
                            color: OsvTheme.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        SectionCard {
                            vertical-stretch: 1;

                            VerticalLayout {
                                vertical-stretch: 1;

                                Rectangle { vertical-stretch: 1; }

                                Text {
                                    text: "Settings panel coming soon";
                                    color: OsvTheme.muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }

                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Preview/Export component
export component OsvControlWindow inherits Window {
    title: "osv-control";
    width: 800px;
    height: 600px;
    background: #0a1628;

    OsvControl {
        active-section: 0;
        cpu-usage: 0.42;
        memory-usage: 0.67;
        disk-usage: 0.35;
        network-up: "1.2";
        network-down: "15.8";
        brightness: 0.8;
        night-mode: false;
        resolution: "1920x1080";
        battery-percentage: 72;
        battery-charging: false;
        battery-state: "Discharging";
        battery-time-remaining: "2h 45m";
        battery-health: 89;
        battery-technology: "Li-ion";
        battery-manufacturer: "Samsung SDI";
        battery-cycle-count: 287;
        current-date: "Monday, January 6, 2025";
        current-time: "14:30";
        timezone: "America/New_York";
        timezone-offset: "UTC-05:00";
        use-24h-format: true;
        ntp-enabled: true;
        ntp-synchronized: true;
        keyboard-layout: "English (US)";
        keyboard-variant: "Default";
        key-repeat-delay: 500;
        key-repeat-rate: 25;
        caps-lock-indicator: true;
        mouse-speed: 0.5;
        mouse-natural-scroll: false;
        mouse-left-handed: false;
        touchpad-speed: 0.5;
        touchpad-tap-to-click: true;
        touchpad-natural-scroll: true;
        touchpad-two-finger-scroll: true;
    }
}
