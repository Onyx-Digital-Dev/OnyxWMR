// OSV Application Launcher (osv-intake)
// Centered overlay launcher with search and results

import { OsvTheme } from "theme.slint";
import { IconSearch, IconX, IconTerminal, IconFolder, IconSettings, IconGlobe, IconImage, IconMonitor, IconCpu, IconGrid } from "icons.slint";

// Application result row
component AppResult {
    in property <string> name: "Application";
    in property <string> icon-type: "terminal";
    in property <bool> selected: false;
    callback clicked();
    
    height: 28px;
    
    Rectangle {
        width: 100%;
        height: 100%;
        background: selected ? OsvTheme.surface : transparent;
        
        // Selected indicator
        if (selected): Rectangle {
            x: 0;
            width: 2px;
            height: 100%;
            background: OsvTheme.accent;
        }
        
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            
            // App icon - supports: terminal, folder, settings, browser, image, monitor, system, default
            Rectangle {
                width: OsvTheme.icon-md;
                height: OsvTheme.icon-md;
                property <color> ic: selected ? OsvTheme.text : OsvTheme.muted;

                if icon-type == "terminal": IconTerminal { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "folder": IconFolder { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "settings": IconSettings { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "browser": IconGlobe { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "image": IconImage { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "monitor": IconMonitor { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "system": IconCpu { size: OsvTheme.icon-md; icon-color: ic; }
                if icon-type == "default": IconGrid { size: OsvTheme.icon-md; icon-color: ic; }
            }
            
            // App name
            Text {
                text: name;
                color: selected ? OsvTheme.text : OsvTheme.muted;
                font-size: OsvTheme.font-body;
                vertical-alignment: center;
            }
        }
        
        animate background { duration: 100ms; }
    }
    
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Main Intake Component
export component OsvIntake {
    in property <string> search-query: "";
    in property <int> selected-index: 0;
    in property <bool> visible: true;
    
    // Sample app list (in real impl, this would be dynamic)
    in property <[{name: string, icon: string}]> results: [
        { name: "Terminal", icon: "terminal" },
        { name: "Files", icon: "folder" },
        { name: "Firefox", icon: "browser" },
        { name: "Settings", icon: "settings" },
    ];
    
    callback search-changed(string);
    callback app-selected(int);
    callback close-requested();
    
    width: 400px;
    min-height: 60px;
    
    Rectangle {
        width: 100%;
        height: 100%;
        background: OsvTheme.osv-bg.with-alpha(0.95);
        border-radius: OsvTheme.radius-lg;
        border-width: 1px;
        border-color: OsvTheme.border;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: rgba(0, 0, 0, 0.5);
        
        VerticalLayout {
            padding: 0;
            
            // Search input
            Rectangle {
                height: 32px;
                background: OsvTheme.surface;
                border-top-left-radius: OsvTheme.radius-lg;
                border-top-right-radius: OsvTheme.radius-lg;
                
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    
                    // Search icon
                    IconSearch {
                        size: 16px;
                        icon-color: OsvTheme.muted;
                    }
                    
                    // Search text input
                    Rectangle {
                        horizontal-stretch: 1;
                        
                        input := TextInput {
                            width: 100%;
                            text: search-query;
                            color: OsvTheme.text;
                            font-size: OsvTheme.font-body;
                            vertical-alignment: center;
                            
                            edited => {
                                search-changed(self.text);
                            }
                        }
                        
                        // Placeholder
                        if (search-query == ""): Text {
                            text: "Search applications...";
                            color: OsvTheme.muted;
                            font-size: OsvTheme.font-body;
                            vertical-alignment: center;
                        }
                    }
                    
                    // Clear button
                    if (search-query != ""): TouchArea {
                        width: 16px;
                        height: 16px;
                        
                        IconX {
                            size: 16px;
                            icon-color: OsvTheme.muted;
                        }
                        
                        clicked => {
                            search-changed("");
                        }
                    }
                }
            }
            
            // Results list
            if (results.length > 0): Rectangle {
                vertical-stretch: 1;
                min-height: results.length * 28px;
                
                VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 0;
                    
                    for result[i] in results: AppResult {
                        name: result.name;
                        icon-type: result.icon;
                        selected: i == selected-index;
                        clicked => { app-selected(i); }
                    }
                }
            }
            
            // Empty state
            if (results.length == 0): Rectangle {
                height: 48px;
                
                Text {
                    text: "No applications found";
                    color: OsvTheme.muted;
                    font-size: OsvTheme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Preview/Export component
export component OsvIntakeWindow inherits Window {
    title: "osv-intake";
    width: 600px;
    height: 400px;
    background: #0a1628;
    
    // Centered intake panel
    OsvIntake {
        x: (parent.width - self.width) / 2;
        y: 80px;
        search-query: "term";
        selected-index: 0;
        results: [
            { name: "Terminal", icon: "terminal" },
            { name: "Terminator", icon: "terminal" },
        ];
    }
}
